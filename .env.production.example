# ═══════════════════════════════════════════════════════════════════════════
# SIAPTIKA — Production Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════

# ─── Konfigurasi Aplikasi ──────────────────────────────────────────────────
APP_NAME=SIAPTIKA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://siaptika.riau.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Supabase PostgreSQL Database (Cloud) ──────────────────────────────────
# Diperoleh dari Supabase Dashboard → Project Settings → Database → Connection Pooling / Direct Connection
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.ciwggazfzainjccecbqw
DB_PASSWORD=
DB_SSLMODE=require

# ─── Sesi & Cookie ─────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ─── Cache & Antrean ───────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ─── Supabase Storage (S3 Protocol) ────────────────────────────────────────
# Diperoleh dari Supabase Dashboard → Project Settings → Storage → S3 Access Keys
SUPABASE_STORAGE_URL=https://ciwggazfzainjccecbqw.supabase.co/storage/v1/s3
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_STORAGE_REGION=ap-southeast-1

VITE_APP_NAME="${APP_NAME}"
